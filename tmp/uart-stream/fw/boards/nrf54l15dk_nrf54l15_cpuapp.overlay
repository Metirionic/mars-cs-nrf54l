/*
 * SPDX-License-Identifier: MIT
 *
 * Mirrors mars-cs-nrf54l/boards/nrf54l15dk_nrf54l15_cpuapp.overlay's UART half
 * exactly (the antenna-switch node is not needed here):
 *
 *  - uart20 is the production COBS UART (TX P1.04 / RX P1.05 -> Interface MCU
 *    -> VCOM1), acquired through the same chosen node production uses.
 *  - uart30 is the production console (-> VCOM0).
 *  - the DK's own dtsi leaves BOTH at 115200 and points zephyr,console at
 *    uart20, so without this file the stream leaves the nRF at 115200 while
 *    the Interface MCU reads 921600 and the console is wired to the wrong
 *    VCOM. Both must be overridden.
 */

/ {
	chosen {
		cobs-uart = &uart20;
		zephyr,console = &uart30;
		zephyr,shell-uart = &uart30;
		zephyr,uart-mcumgr = &uart30;
		zephyr,bt-mon-uart = &uart30;
		zephyr,bt-c2h-uart = &uart30;
	};
};

&uart30 {
	status = "okay";
	current-speed = <921600>;
};

&uart20 {
	status = "okay";
	current-speed = <921600>;
	/* 1 Mbps was measured 2026-10-14 (README matrix) on the Jun-2026 OB: broken,
	 * because that image's VCOM saturates at ~37 KB/s whatever the baud. The
	 * 2026-10-15 Jul-2025-OB run at 1 Mbps used the prebuilt app image kept at
	 * build/fw-1m. 921600 is the default because it mirrors production.
	 *
	 * 2026-10-11 firmware-matrix test (results in README.md): the Jun-11-2026
	 * OB firmware delivers this stream damaged at 921600 and 460800 (mid-frame
	 * corruption of long frames; frame heads arrive; short status frames parse)
	 * and perfectly at 115200. The Jul-8-2025 OB firmware delivers 921600
	 * 99.998% intact. 921600 stays the default: it mirrors production. */
};
